PORT=5000
CLIENT_ORIGIN=http://localhost:5173
FIREBASE_DATABASE_URL=https://sun-glaze-pro-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_PROJECT_ID=sun-glaze-pro
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
OTP_HMAC_SECRET=replace-with-at-least-32-random-bytes
SMS_PROVIDER=console
# TEMPORARY OTP on-screen display: ON by default when NODE_ENV!=production; set OTP_DEBUG_DISPLAY=false to disable.
# In production it needs OTP_DEBUG_DISPLAY=true AND ALLOW_OTP_DISPLAY_IN_PRODUCTION=true.
NODE_ENV=development
